+def persist_transport_failure(folder, slot, gate, error, diagnostic_reader, run_id, runtime_sha):
+    """Save optional metadata after the gate closes, without masking its error.
+
+    A diagnostic is not a returned response or a completed reservation. Any
+    capture/write failure stays terminal and cannot cause another dispatch.
+    """
+    status = dict(status='UNAVAILABLE', slot_id=slot['slot_id'])
+    try:
+        value = diagnostic_reader() if diagnostic_reader is not None else None
+        if value is None:
+            return status
+        diagnostic = validate_failure_diagnostic(value)
+        entry = gate.state['reservations'][-1]
+        r.require(gate.closed and entry['attempt_id'] == slot['slot_id'] and
+                  entry['status'] == 'AMBIGUOUS_OR_UNSAVED' and entry['error_type'] == type(error).__name__,
+                  'Diagnostic is not the terminal reservation')
+        record = dict(schema='repodisco-growth-transport-error-evidence-v1', run_id=run_id,
+                      runtime_sha256=runtime_sha, slot_id=slot['slot_id'], stage_id=slot['stage_id'],
+                      reservation_sequence=entry['sequence'],
+                      request_sha256=r.sha((folder/'request.json').read_bytes()),
+                      reservation_sha256=r.sha(r.canonical(entry)), error_type=type(error).__name__,
+                      diagnostic=diagnostic, returned_model_response=False, proof_score=None)
+        status['status'] = 'WRITE_FAILED'
+        raw = r.encode(record)
+        write_bytes(folder/'transport-error.json', raw)
+        return dict(status='SAVED', slot_id=slot['slot_id'], artifact_sha256=r.sha(raw))
+    except BaseException:
+        if status['status'] == 'UNAVAILABLE':
+            status['status'] = 'CAPTURE_FAILED'
+        return status
 
 
